+def _carried_conversation(monkeypatch: pytest.MonkeyPatch, method: str, decode_eviction: str) -> Any:
+    monkeypatch.setenv("MODEL_TYPE", "llava-7B")
+    monkeypatch.setenv("KV_CACHE_TYPE", method)
+    monkeypatch.setenv("PRUNE_RATIO", "0.5")
+    monkeypatch.setenv("MULTI_TURN_DECODE_EVICTION", decode_eviction)
+    torch, model, first = _tiny_llava(num_layers=32)
+    from lmms_eval.models.model_utils.kv_carryover import CarryOverConversation
+
+    import utils.generate_patches as patches
+    from kv_caches import get_kv_cache
+
+    monkeypatch.setattr(patches, "get_kv_cache", get_kv_cache)
+    conv = CarryOverConversation(model, _IdsAdapter(first))
+    conv.start(first)
+    return model, conv
+
+
+@pytest.mark.parametrize("method", ["h2o", "local"])
+def test_h2o_and_local_multi_turn_compress_each_prefill_to_the_conversation_budget(monkeypatch: pytest.MonkeyPatch, method: str) -> None:
+    model, conv = _carried_conversation(monkeypatch, method, decode_eviction="0")
+    seen_inputs: List[List[int]] = []
+    hook = model.register_forward_pre_hook(lambda mod, args, kwargs: seen_inputs.append(kwargs["input_ids"][0].tolist()), with_kwargs=True)
+    conv.generate()
+    for ids in ([200, 201, 202, 203, 204, 205], [210, 211, 212, 213]):
+        expected_new = conv.pending + ids
+        conv.extend(ids)
+        seen_inputs.clear()
+        conv.generate()
+        assert seen_inputs[0] == expected_new  # the prefill processes only the new tokens
+        after_prefill = sum(conv.criteria.after_prefill)
+        assert after_prefill == math.ceil(0.5 * (len(conv.stream) - 5))
+        lengths = [p[0].shape[-2] for p in conv.cache]
+        assert lengths == [f.numel() for f in conv.criteria.is_image]
+        assert set(lengths) == {after_prefill + 5}  # decode eviction off: all 5 answer tokens kept
+        if method == "h2o":
+            assert conv.criteria.scores.numel() == lengths[0]  # one accumulated score per cached entry
+    hook.remove()
+
+
+@pytest.mark.parametrize("method", ["h2o", "local"])
+def test_h2o_and_local_multi_turn_decode_eviction_holds_the_budget(monkeypatch: pytest.MonkeyPatch, method: str) -> None:
+    model, conv = _carried_conversation(monkeypatch, method, decode_eviction="1")
+    conv.generate()
+    conv.extend([200, 201, 202, 203, 204, 205])
+    conv.generate()
+    assert {p[0].shape[-2] for p in conv.cache} == {int(0.5 * len(conv.stream))}
+    assert [f.numel() for f in conv.criteria.is_image] == [p[0].shape[-2] for p in conv.cache]
+
